+            fprintf(stderr, "BONSAI_PROF: weight table full at %d, per-weight numbers are now incomplete\n",
+                    BONSAI_PROF_MAX_W);
+        }
+        return -1;
+    }
+    g_prof_w[g_prof_w_n] = t;
+    return g_prof_w_n++;
+}
+
+static inline uint64_t g_prof_now(void) {
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t) ts.tv_sec * 1000000000ULL + (uint64_t) ts.tv_nsec;
+}
+
+// page-fault counters for this process, so a per-graph op time can be regressed against the
+// faults that graph took instead of assuming a cost per fault
+static void g_prof_faults(uint64_t * minf, uint64_t * majf) {
+    *minf = 0;
+    *majf = 0;
+    FILE * f = fopen("/proc/self/stat", "r");
+    if (!f) return;
+    char buf[4096];
+    const size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+    fclose(f);
+    buf[n] = 0;
+    const char * p = strrchr(buf, ')');
+    if (!p) return;
+    p++;
+    // after the comm field: state(3) ppid(4) pgrp(5) session(6) tty(7) tpgid(8) flags(9)
+    // minflt(10) cminflt(11) majflt(12)
+    unsigned long long a1,a2,a3,a4,a5,a6,mn,cm,mj;
+    if (sscanf(p, " %*c %llu %llu %llu %llu %llu %llu %llu %llu %llu",
+               &a1,&a2,&a3,&a4,&a5,&a6,&mn,&cm,&mj) == 9) {
+        *minf = mn;
+        *majf = mj;
+    }
+}
+
+static void g_prof_dump(void) {
+    uint64_t mn, mj;
+    g_prof_faults(&mn, &mj);
+    fprintf(stderr, "\n=== CPU OP PROFILE after %llu graphs minflt=%llu majflt=%llu ===\n",
+        (unsigned long long) g_prof_graphs, (unsigned long long) mn, (unsigned long long) mj);
+    for (int op = 0; op < GGML_OP_COUNT; ++op) {
+        if (!g_prof_op_calls[op]) continue;
+        fprintf(stderr, "  %-22s %9.2f ms total %8.3f ms/graph %9llu calls\n",
+            ggml_op_name((enum ggml_op) op),
+            g_prof_op_ns[op] / 1e6, g_prof_op_ns[op] / 1e6 / (double) g_prof_graphs,
+            (unsigned long long) g_prof_op_calls[op]);
+    }
+    for (int t = 0; t < GGML_TYPE_COUNT; ++t) {
+        if (!g_prof_type_ns[t]) continue;
+        fprintf(stderr, "  MATMUL %-14s %9.2f ms total %8.3f ms/graph %9llu calls "
+                        "(mm=%llu mmid=%llu) %12llu bytes\n",
+            ggml_type_name((enum ggml_type) t),
+            g_prof_type_ns[t] / 1e6, g_prof_type_ns[t] / 1e6 / (double) g_prof_graphs,
+            (unsigned long long) g_prof_type_calls[t],
+            (unsigned long long) g_prof_type_calls_mm[t],
+            (unsigned long long) g_prof_type_calls_mmid[t],
+            (unsigned long long) g_prof_type_bytes[t]);
+    }
+    if (g_prof_w_n > 0) {
+        // aggregate every tracked weight, so the byte and bandwidth totals do not depend
+        // on the top-30 list below
+        uint64_t dn = 0, db = 0, dc = 0, en = 0, eb = 0, ec = 0;
+        for (int i = 0; i < g_prof_w_n; ++i) {
+            if (strstr(g_prof_w[i]->name, "_exps.")) {
+                en += g_prof_w_ns[i]; eb += g_prof_w_by[i]; ec += g_prof_w_call[i];
+            } else {
+                dn += g_prof_w_ns[i]; db += g_prof_w_by[i]; dc += g_prof_w_call[i];
+            }
+        }
+        const double dms = dn / 1e6, ems = en / 1e6;
+        fprintf(stderr, "  AGG dense  %10.2f ms tot %8.3f ms/graph %7llu calls %9.1f MiB %7.1f GiB/s\n",
+            dms, dms / (double) g_prof_graphs, (unsigned long long) dc, db / 1048576.0,
+            dms > 0.0 ? (db / 1073741824.0) / (dms / 1000.0) : 0.0);
+        fprintf(stderr, "  AGG expert %10.2f ms tot %8.3f ms/graph %7llu calls %9.1f MiB %7.1f GiB/s\n",
+            ems, ems / (double) g_prof_graphs, (unsigned long long) ec, eb / 1048576.0,
+            ems > 0.0 ? (eb / 1073741824.0) / (ems / 1000.0) : 0.0);
+
+        static bool used[BONSAI_PROF_MAX_W];
+        memset(used, 0, sizeof(used));
+        fprintf(stderr, "  --- top weights (cumulative) ---\n");
+        for (int k = 0; k < 30; ++k) {
+            int best = -1;
+            for (int i = 0; i < g_prof_w_n; ++i) {
+                if (used[i]) continue;
+                if (best < 0 || g_prof_w_ns[i] > g_prof_w_ns[best]) best = i;
+            }
+            if (best < 0 || g_prof_w_ns[best] == 0) break;
+            used[best] = true;
+            const double ms  = g_prof_w_ns[best] / 1e6;
+            const double mib = g_prof_w_by[best] / 1048576.0;
+            fprintf(stderr, "  W %-32s %9.2f ms tot %8.3f ms/graph %7llu calls %9.1f MiB %7.1f GiB/s\n",
+                g_prof_w[best]->name, ms, ms / (double) g_prof_graphs,
+                (unsigned long long) g_prof_w_call[best], mib,
+                ms > 0.0 ? (mib / 1024.0) / (ms / 1000.0) : 0.0);
+        }
+        // the 144 expert tensors crowd the list above, so the dense backbone and the
+        // embedding tables (GET_ROWS) need their own selection to be visible at all
+        memset(used, 0, sizeof(used));
+        fprintf(stderr, "  --- top dense weights (cumulative) ---\n");
+        for (int k = 0; k < 16; ++k) {
+            int best = -1;
+            for (int i = 0; i < g_prof_w_n; ++i) {
+                if (used[i]) continue;
+                if (strstr(g_prof_w[i]->name, "_exps.")) continue;
+                if (best < 0 || g_prof_w_ns[i] > g_prof_w_ns[best]) best = i;
+            }
+            if (best < 0 || g_prof_w_ns[best] == 0) break;
+            used[best] = true;
+            const double ms  = g_prof_w_ns[best] / 1e6;
+            const double mib = g_prof_w_by[best] / 1048576.0;
+            fprintf(stderr, "  D %-32s %9.2f ms tot %8.3f ms/graph %7llu calls %9.1f MiB %7.1f GiB/s\n",
+                g_prof_w[best]->name, ms, ms / (double) g_prof_graphs,
+                (unsigned long long) g_prof_w_call[best], mib,
+                ms > 0.0 ? (mib / 1024.0) / (ms / 1000.0) : 0.0);
+        }
+    }
+    fflush(stderr);
+}
