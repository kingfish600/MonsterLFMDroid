+          const float s0_ = dd_ * GGML_CPU_FP16_TO_FP32(y_[0].d); \
+          const float s1_ = dd_ * GGML_CPU_FP16_TO_FP32(y_[1].d); \
+          (ACC1) = vmlaq_n_f32((ACC1), vcvtq_f32_s32(S7_GROUP(q0_, q1_, vld1q_s8(y_[0].qs), vld1q_s8(y_[0].qs + 16))), s0_); \
+          (ACC1) = vmlaq_n_f32((ACC1), vcvtq_f32_s32(S7_GROUP(q2_, q3_, vld1q_s8(y_[1].qs), vld1q_s8(y_[1].qs + 16))), s1_); } \
