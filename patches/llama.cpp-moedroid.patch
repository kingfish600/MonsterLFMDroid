+        float32x4_t e0 = vdupq_n_f32(0.0f), e1 = vdupq_n_f32(0.0f);
+        float32x4_t e2 = vdupq_n_f32(0.0f), e3 = vdupq_n_f32(0.0f);
+        float32x4_t o0 = vdupq_n_f32(0.0f), o1 = vdupq_n_f32(0.0f);
+        float32x4_t o2 = vdupq_n_f32(0.0f), o3 = vdupq_n_f32(0.0f);
+
+        int i = 0;
+        for (; i + 1 < nb; i += 2) {
+            S7_TOK4_BLOCK(i,     e0, e1, e2, e3);
