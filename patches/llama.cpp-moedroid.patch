+
+static void bonsai_pk_report_once(void) {
+    static int done;
+    if (done) return;
+    done = 1;
+    if (getenv("BONSAI_PK_REPORT") && atoi(getenv("BONSAI_PK_REPORT")) > 0) {
+        const char * e = getenv("BONSAI_PK_EVERY");
+        const char * f = getenv("BONSAI_PK_FIRST");
+        g_pk_every = e ? atoi(e) : 512;
+        g_pk_first = f ? atoi(f) : 1;
+        atexit(bonsai_pk_atexit);
+    } else {
