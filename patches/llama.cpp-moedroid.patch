+        s2[ix] = vaddvq_f32(vaddq_f32(e2, o2));
+        s3[ix] = vaddvq_f32(vaddq_f32(e3, o3));
+    }
+
+    #undef S7_DEQ
+    #undef S7_GROUP
+    #undef S7_TOK4_BLOCK
+    return 1;
+}
