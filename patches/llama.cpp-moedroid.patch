+          (ACC2) = vmlaq_n_f32((ACC2), vcvtq_f32_s32(S7_GROUP(q0_, q1_, vld1q_s8(y_[0].qs), vld1q_s8(y_[0].qs + 16))), s0_); \
+          (ACC2) = vmlaq_n_f32((ACC2), vcvtq_f32_s32(S7_GROUP(q2_, q3_, vld1q_s8(y_[1].qs), vld1q_s8(y_[1].qs + 16))), s1_); } \
+        { const block_q8_0 * y_ = (const block_q8_0 *) vy3 + 2 * (BLK); \
+          const float s0_ = dd_ * GGML_CPU_FP16_TO_FP32(y_[0].d); \
+          const float s1_ = dd_ * GGML_CPU_FP16_TO_FP32(y_[1].d); \
+          (ACC3) = vmlaq_n_f32((ACC3), vcvtq_f32_s32(S7_GROUP(q0_, q1_, vld1q_s8(y_[0].qs), vld1q_s8(y_[0].qs + 16))), s0_); \
+          (ACC3) = vmlaq_n_f32((ACC3), vcvtq_f32_s32(S7_GROUP(q2_, q3_, vld1q_s8(y_[1].qs), vld1q_s8(y_[1].qs + 16))), s1_); } \
