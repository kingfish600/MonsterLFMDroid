+    const long g = (long) atomic_fetch_add(&g_pk_graphs, 1) + 1;
+    if (g == g_pk_first) { bonsai_pk_print("periodic"); return; }
+    if (g_pk_every <= 0) return;
+    if (g % g_pk_every == 0) bonsai_pk_print("periodic");
