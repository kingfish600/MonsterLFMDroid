+#if defined(__ARM_FEATURE_BF16_VECTOR_ARITHMETIC)
+    // Hardware BF16 dot: one instruction per 8 pairs, no unpacking. Needs
+    // -march=...+bf16 and a CPU with FEAT_BF16 (probe before shipping this).
+    {
+        float32x4_t bf_lo = vdupq_n_f32(0.0f);
+        float32x4_t bf_hi = vdupq_n_f32(0.0f);
+        const bfloat16_t * x_b = (const bfloat16_t *) x;
+        const bfloat16_t * y_b = (const bfloat16_t *) y;
+        for (; i + 15 < n; i += 16) {
+            bf_lo = vbfdotq_f32(bf_lo, vld1q_bf16(x_b + i),     vld1q_bf16(y_b + i));
+            bf_hi = vbfdotq_f32(bf_hi, vld1q_bf16(x_b + i + 8), vld1q_bf16(y_b + i + 8));
+        }
+        for (; i + 7 < n; i += 8) {
+            bf_lo = vbfdotq_f32(bf_lo, vld1q_bf16(x_b + i), vld1q_bf16(y_b + i));
+        }
+        sumf += (ggml_float) vaddvq_f32(vaddq_f32(bf_lo, bf_hi));
+    }
+#elif defined(__ARM_NEON) && !defined(BONSAI_NO_BF16_NEON)
+    // BF16 -> F32 is an exact 16-bit left shift (BF16 is the top half of F32),
+    // so this needs neither +bf16 nor any conversion of the operand vectors.
+    {
+        float32x4_t sum_lo = vdupq_n_f32(0.0f);
+        float32x4_t sum_hi = vdupq_n_f32(0.0f);
+        const uint16_t * x_u16 = (const uint16_t *) x;
+        const uint16_t * y_u16 = (const uint16_t *) y;
+        for (; i + 7 < n; i += 8) {
+            const uint16x8_t vx = vld1q_u16(x_u16 + i);
+            const uint16x8_t vy = vld1q_u16(y_u16 + i);
+            const float32x4_t x0 = vreinterpretq_f32_u32(vshll_n_u16(vget_low_u16(vx),  16));
+            const float32x4_t x1 = vreinterpretq_f32_u32(vshll_n_u16(vget_high_u16(vx), 16));
+            const float32x4_t y0 = vreinterpretq_f32_u32(vshll_n_u16(vget_low_u16(vy),  16));
+            const float32x4_t y1 = vreinterpretq_f32_u32(vshll_n_u16(vget_high_u16(vy), 16));
+            sum_lo = vfmaq_f32(sum_lo, x0, y0);
+            sum_hi = vfmaq_f32(sum_hi, x1, y1);
+        }
+        sumf += (ggml_float) vaddvq_f32(vaddq_f32(sum_lo, sum_hi));
