+// --- diag: per-op WALL-CLOCK timing (BONSAI_PROF), format-compatible with our fork ---
+//
+// Thread 0 alone takes the timestamps: t0 immediately before ggml_compute_forward and dt
+// immediately after the ggml_barrier() that ends the node. Because every worker must reach that
+// barrier, dt is the node's true wall-clock time on the whole threadpool, not one worker's share
+// of it. The previous version timed every worker and summed the rows, which reported ~537 ms per
+// graph (6x the wall time) and perturbed the measurement with 6x clock_gettime per node; that is
+// why Stage 7 could not compare ik's milliseconds against our fork's.
+//
+// The output block is byte-compatible with the fork's (ggml/src/ggml-cpu/ggml-cpu.c, g_prof_dump),
+// so MoeDroid/tools/s4_prof.py parses both engines without special-casing. Two extra
+// BONSAI_PROF* diagnostic lines are emitted that the parser ignores:
+//   BONSAI_PROF WALL  - thread 0's total time across the node loop, so the sum of the op rows can
+//                       be checked against the graph's real wall time (see s8_prof_verify.c)
+//   BONSAI_PROF WORK  - only when BONSAI_PROF_WORKERS=1: the old per-worker sum, kept as a
+//                       diagnostic for how far CPU-time shares drift from wall time
+#ifndef BONSAI_PROF
+#define BONSAI_PROF 0
+#endif
+#if BONSAI_PROF
+#define BONSAI_PROF_MAX_THREADS 64
+
+// thread 0's wall-clock rows: the only ones used for the report
+static uint64_t g_bp_ns         [GGML_OP_COUNT];
+static uint64_t g_bp_calls      [GGML_OP_COUNT];
+static uint64_t g_bp_type_ns    [GGML_TYPE_COUNT];
+static uint64_t g_bp_type_calls [GGML_TYPE_COUNT];
+static uint64_t g_bp_wall_ns;               // thread 0: total node-loop wall time
+// optional per-worker CPU-time rows (diagnostic only)
+static uint64_t g_bp_worker_ns   [BONSAI_PROF_MAX_THREADS][GGML_OP_COUNT];
+static uint64_t g_bp_worker_calls[BONSAI_PROF_MAX_THREADS][GGML_OP_COUNT];
+static uint64_t g_bp_graphs;
+static int      g_bp_enabled = -1;
+static long     g_bp_every   = 1;
+static int      g_bp_workers = -1;
+
+static inline int bonsai_bp_on(void) {
+    if (g_bp_enabled < 0) {
+        const char * e = getenv("BONSAI_PROF");
+        const char * v = getenv("BONSAI_PROF_EVERY");
+        const char * w = getenv("BONSAI_PROF_WORKERS");
+        // Enable on BONSAI_PROF *or* BONSAI_PROF_EVERY, matching our fork (ggml-cpu.c only reads
+        // BONSAI_PROF_EVERY). Requiring BONSAI_PROF here made every Stage 8 profiler arm that set
+        // only BONSAI_PROF_EVERY dump nothing at all, which the clock gate then reported as an
+        // unmeasurable pair - correct behaviour, wrong cause.
+        g_bp_enabled = (e && atoi(e) > 0) ? 1 : ((v && atol(v) > 0) ? 1 : 0);
+        g_bp_every   = v ? atol(v) : 1;
+        g_bp_workers = w ? atoi(w) : 0;
+        if (g_bp_every < 1) g_bp_every = 1;
+    }
+    return g_bp_enabled;
+}
+static inline int bonsai_bp_workers(void) { (void) bonsai_bp_on(); return g_bp_workers; }
+
+static inline uint64_t bonsai_bp_now(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t) ts.tv_sec * 1000000000ULL + (uint64_t) ts.tv_nsec;
+}
+
+static void bonsai_bp_faults(uint64_t * minf, uint64_t * majf) {
+    *minf = 0;
+    *majf = 0;
+    FILE * f = fopen("/proc/self/stat", "r");
+    if (!f) return;
+    char buf[4096];
+    const size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+    fclose(f);
+    buf[n] = 0;
+    const char * p = strrchr(buf, ')');
+    if (!p) return;
+    p++;
+    unsigned long long a1,a2,a3,a4,a5,a6,mn,cm,mj;
+    if (sscanf(p, " %*c %llu %llu %llu %llu %llu %llu %llu %llu %llu",
+               &a1,&a2,&a3,&a4,&a5,&a6,&mn,&cm,&mj) == 9) {
+        *minf = mn;
+        *majf = mj;
+    }
+}
+
+static void bonsai_bp_dump(void) {
+    uint64_t mn, mj;
+    bonsai_bp_faults(&mn, &mj);
+    fprintf(stderr, "\n=== CPU OP PROFILE after %llu graphs minflt=%llu majflt=%llu ===\n",
+        (unsigned long long) g_bp_graphs, (unsigned long long) mn, (unsigned long long) mj);
+    for (int op = 0; op < GGML_OP_COUNT; ++op) {
+        if (!g_bp_calls[op]) continue;
+        fprintf(stderr, "  %-22s %9.2f ms total %8.3f ms/graph %9llu calls\n",
+            ggml_op_name((enum ggml_op) op),
+            g_bp_ns[op] / 1e6, g_bp_ns[op] / 1e6 / (double) g_bp_graphs,
+            (unsigned long long) g_bp_calls[op]);
+    }
+    for (int t = 0; t < GGML_TYPE_COUNT; ++t) {
+        if (!g_bp_type_ns[t]) continue;
+        fprintf(stderr, "  MATMUL %-14s %9.2f ms total %8.3f ms/graph\n",
+            ggml_type_name((enum ggml_type) t),
+            g_bp_type_ns[t] / 1e6, g_bp_type_ns[t] / 1e6 / (double) g_bp_graphs);
+    }
+
+    uint64_t sum_op = 0;
+    for (int op = 0; op < GGML_OP_COUNT; ++op) sum_op += g_bp_ns[op];
+    uint64_t sum_ty = 0;
+    for (int t = 0; t < GGML_TYPE_COUNT; ++t) sum_ty += g_bp_type_ns[t];
+    fprintf(stderr, "BONSAI_PROF WALL graphs=%llu wall_ms=%.3f sum_op_ms=%.3f sum_type_ms=%.3f\n",
+        (unsigned long long) g_bp_graphs, g_bp_wall_ns / 1e6, sum_op / 1e6, sum_ty / 1e6);
+
+    if (bonsai_bp_workers()) {
+        uint64_t wsum = 0;
+        for (int t = 0; t < BONSAI_PROF_MAX_THREADS; ++t)
+            for (int op = 0; op < GGML_OP_COUNT; ++op) wsum += g_bp_worker_ns[t][op];
+        fprintf(stderr, "BONSAI_PROF WORK worker_sum_ms=%.3f (CPU-time shares, NOT wall clock)\n",
+            wsum / 1e6);
+    }
+    fflush(stderr);
+}
+#endif // BONSAI_PROF
